{
  "manifest_version": 3,
  "name": "CertifAI",
  "version": "0.1.0",
  "description": "Fills out forms.",
  "icons": {
   "128": "icons/extension_icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "identity",   
    "identity.email"
  ],
  "web_accessible_resources": [{
    "resources": [
    "lib/pdfjs/*", 
    "lib/pdf.worker.mjs", 
    "lib/pdf.mjs", 
    "chat_page/chat_page.html", 
    "lib/marked.min.js", 
    "lib/purify.min.js"
  ],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "host_permissions": [
    "https://api.openai.com/*",
    "http://100.102.38.119:1235/*",
    "http://localhost/*"
  ],
  "oauth2": {
    "client_id": "596008921176-ve1ftr4aeuble7keodb2cdv5su0n41m1.apps.googleusercontent.com",
    "scopes": [
      "profile",
      "email"
    ]
  },
  "content_scripts": [
    {
      "matches": [
      "https://cooisupplierprd.oaklandca.gov/*", 
      "https://ltss.oaklandnet.com/Apply/Apply1/BusinessLicense"
      ],

      "js": ["content/content.js"]
    }
  ]
}